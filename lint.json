 } from '../state/config.store';\nimport { UserStore } from '../state/user.store';\nimport { ApiResponse, ParamValue } from '../interfaces/api-response';\nimport { Topic } from '../interfaces/topic';\nimport { Idea } from '../interfaces/idea';\nimport { Ideation, IdeationFolder, IdeaComment, IdeaReport as IdeaReportInterface, IdeaVoter } from '../interfaces/ideation';\n\nexport interface TopicIdeationParams extends ListParams {\n  topicId: string;\n}\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class TopicIdeationService extends ItemsListService<TopicIdeationParams, Ideation> {\n  private http = inject(HttpClient);\n  private configStore = inject(ConfigStore);\n  private userStore = inject(UserStore);\n  private topicService = inject(TopicService);\n\n  private get apiUrl() {\n    return this.configStore.api.baseUrl();\n  }\n\n  public readonly STATUSES = {\n    draft: 'draft',\n    ideation: 'ideation'\n  };\n\n  public readonly COMMENT_TYPES_MAXLENGTH = {\n    reply: 2048\n  };\n\n  public readonly IDEA_REPORT_TYPES = {\n    abuse: 'abuse',\n    obscene: 'abuse',\n    spam: 'abuse',\n    hate: 'abuse',\n    duplicate: 'abuse',\n    other: 'abuse'\n  };\n\n  public readonly COMMENT_REPORT_TYPES = {\n    abuse: 'abuse',\n    obscene: 'abuse',\n    spam: 'abuse',\n    hate: 'abuse',\n    other: 'abuse'\n  };\n\n  public loadIdeations$ = new Subject<void>();\n\n  constructor() {\n    super();\n    this.setDefaults({ limit: 100, offset: 0 });\n  }\n\n  override getItems(params: TopicIdeationParams): Observable<{ rows: Ideation[]; countTotal: number }> {\n    const path = this.getAbsoluteUrlApi(`/topics/${params.topicId}/ideations`);\n    let httpParams = new HttpParams();\n    Object.keys(params).forEach(key => {\n      const val = (params as Record<string, unknown>)[key];\n      if (val !== undefined && val !== null) {\n        httpParams = httpParams.set(key, String(val));\n      }\n    });\n\n    return this.http.get<ApiResponse<{ rows: Ideation[]; count: number }>>(path, { withCredentials: true, params: httpParams }).pipe(\n      map(res => ({\n        rows: res.data?.rows ?? [],\n        countTotal: res.data?.count ?? 0\n      }))\n    );\n  }\n\n  query(params: TopicIdeationParams): Observable<Ideation[]> {\n    const path = this.getAbsoluteUrlApi(`/topics/${params.topicId}/ideations`);\n    let httpParams = new HttpParams();\n    Object.keys(params).forEach(key => {\n      const val = (params as Record<string, unknown>)[key];\n      if (val !== undefined && val !== null) {\n        httpParams = httpParams.set(key, String(val));\n      }\n    });\n\n    return this.http.get<ApiResponse<Ideation[]>>(path, { withCredentials: true, params: httpParams }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  get(data: { topicId: string; ideationId: string }): Observable<Ideation> {\n    const path = this.getAbsoluteUrlApi(`/topics/${data.topicId}/ideations/${data.ideationId}`);\n    return this.http.get<ApiResponse<Ideation>>(path, { withCredentials: true }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  save(data: { topicId: string; [key: string]: unknown }): Observable<Ideation> {\n    const { topicId, ...body } = data;\n    const path = this.getAbsoluteUrlApi(`/topics/${topicId}/ideations`);\n    return this.http.post<ApiResponse<Ideation>>(path, body, { withCredentials: true }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  update(data: { topicId: string; ideationId: string; [key: string]: unknown }): Observable<Ideation> {\n    const { topicId, ideationId, ...body } = data;\n    const id = ideationId || (body as any).id;\n    const path = this.getAbsoluteUrlApi(`/topics/${topicId}/ideations/${id}`);\n    return this.http.put<ApiResponse<Ideation>>(path, body, { withCredentials: true }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  delete(data: { topicId: string; ideationId: string }): Observable<unknown> {\n    const path = this.getAbsoluteUrlApi(`/topics/${data.topicId}/ideations/${data.ideationId}`);\n    return this.http.delete<ApiResponse<unknown>>(path, { withCredentials: true }).pipe(\n      map(res => res.data)\n    );\n  }\n\n  getIdeas(params: { topicId: string; ideationId: string; [key: string]: unknown }): Observable<{ rows: Idea[]; countTotal: number; count: number }> {\n    const { topicId, ideationId, ...rest } = params;\n    const path = this.getAbsoluteUrlApi(`/topics/${topicId}/ideations/${ideationId}/ideas`);\n    let httpParams = new HttpParams();\n    Object.keys(rest).forEach(key => {\n      const val = rest[key] as ParamValue;\n      if (val !== undefined && val !== null) {\n        if (Array.isArray(val)) {\n          val.forEach(v => httpParams = httpParams.append(key, String(v)));\n        } else {\n          httpParams = httpParams.set(key, String(val));\n        }\n      }\n    });\n\n    return this.http.get<ApiResponse<{ rows: Idea[]; count: number }>>(path, { withCredentials: true, params: httpParams }).pipe(\n      map(res => ({\n        rows: res.data?.rows ?? [],\n        countTotal: res.data?.count ?? 0,\n        count: res.data?.count ?? 0\n      }))\n    );\n  }\n\n  getIdea(data: { topicId: string; ideationId: string; ideaId: string }): Observable<Idea> {\n    const path = this.getAbsoluteUrlApi(`/topics/${data.topicId}/ideations/${data.ideationId}/ideas/${data.ideaId}`);\n    return this.http.get<ApiResponse<Idea>>(path, { withCredentials: true }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  createIdea(data: { topicId: string; ideationId: string; [key: string]: unknown }): Observable<Idea> {\n    const { topicId, ideationId, ...body } = data;\n    const path = this.getAbsoluteUrlApi(`/topics/${topicId}/ideations/${ideationId}/ideas`);\n    return this.http.post<ApiResponse<Idea>>(path, body, { withCredentials: true }).pipe(\n      map(res => res.data!)\n    );\n  }\n\n  updateIdea(data: { topicId: string; ideationId: string; ideaId: string; [key: string]: unknown }): Observable<Idea> {\n    const { topicId, ideation