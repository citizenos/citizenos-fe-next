ions')\n    );\n    const prefix = (this.userStore.isAuthenticated() && !isPublicPath) ? '/api/users/self' : '/api';\n    return `${this.apiUrl}${prefix}${path}`;\n  }\n\n  loadIdeation(params?: TopicIdeationParams): Observable<{ rows: Ideation[]; countTotal: number }> {\n    return this.loadIdeations$.pipe(\n      exhaustMap(() => this.getItems(params ?? this.params())),\n      shareReplay(1)\n    );\n  }\n\n  reloadIdeation(): void {\n    this.loadIdeations$.next();\n  }\n\n  hasIdeationEnded(topic: Topic, ideation: Ideation): boolean {\n    return ([this.STATUSES.draft, this.STATUSES.ideation].indexOf(topic.status) === -1) || !!(ideation?.deadline && new Date() > new Date(ideation.deadline));\n  }\n\n  hasIdeationEndedExpired(topic: Topic, ideation: Ideation): boolean {\n    return ([this.STATUSES.draft, this.STATUSES.ideation].indexOf(topic.status) === -1) || !!(ideation?.deadline && new Date() > new Date(ideation.deadline));\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/ilmar/citizenos/citizenos-fe-next/src/app/core/services/topic-invite-user.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/ilmar/citizenos/citizenos-fe-next/src/app/core/services/topic-join.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/ilmar/citizenos/citizenos-fe-next/src/app/core/services/topic-member-group.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/ilmar/citizenos/citizenos-fe-next/src/app/core/services/topic-member-user.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixabl