{
  "name": "citizenos-fe-next",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "node server.js",
    "heroku-postbuild": "npm run build",
    "build": "node ./prebuild.js && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:public": "playwright test --project=public",
    "e2e:auth": "playwright test --project=authenticated",
    "e2e:debug": "playwright test --headed --debug",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/validator": "^13.15.10",
    "@web-eid/web-eid-library": "^2.1.0-beta.2",
    "angularx-qrcode": "^21.0.5",
    "config": "^4.4.1",
    "easymde": "^2.21.0",
    "express": "^5.2.1",
    "express-csp-header": "^6.3.1",
    "fast-json-patch": "^3.1.1",
    "lodash": "^4.18.1",
    "marked": "^18.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "validator": "^13.15.35",
    "web-eid": "^0.0.8"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/marked": "^5.0.2",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
